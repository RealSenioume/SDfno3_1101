# -*- mode: python ; coding: utf-8 -*-
r"""PyInstaller build description for lolping v0.2.0 (Windows, one-folder, windowed).

Build it with the wrapper script (recommended) or directly:

    .\.venv-build\Scripts\python.exe -m PyInstaller --noconfirm `
        --distpath dist --workpath build\_work build\lolping.spec

The result is ``dist\\lolping\\lolping.exe`` plus ``dist\\lolping\\_internal\\``.

Design notes
------------
* One-folder (not one-file): a one-file build unpacks ~40 MB of Qt DLLs into a
  temporary directory on every launch, which adds seconds to the cold start of
  a latency-sensitive overlay.  Keep the folder intact when distributing.
* ``console=False`` (windowed): double-clicking the exe must not open a black
  console window.  Consequence: ``print()``/stderr output is not visible, so
  the build script verifies the frozen app through its exit code instead.
* UPX is disabled: it is not installed on the build machine, and compressed
  executables are a classic antivirus / SmartScreen false-positive source.
* Excludes drop the unused Qt subsystems (WebEngine, Network, QML, Quick) and
  CPython libraries the application never touches, which keeps the release zip
  small.
* The icon is optional.  Drop a multi-size ``assets\\lolping.ico`` next to
  ``src`` and it is picked up automatically; see docs/07-build-and-release.md
  for how to regenerate one.
"""

import tempfile
from pathlib import Path

# PyInstaller injects SPECPATH (the directory containing this spec file).
ROOT = Path(SPECPATH).resolve().parent
SRC = ROOT / "src"
APP_NAME = "lolping"
ICON_PATH = ROOT / "assets" / "lolping.ico"

# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------
# PyInstaller runs the given script as the top-level ``__main__`` module and
# does *not* place it inside its package.  ``src/lolping/__main__.py`` starts
# with ``from .app import main``, so pointing PyInstaller at it directly would
# build an exe that dies with
#     ImportError: attempted relative import with no known parent package
# (pyinstaller/pyinstaller#2560 is still open).  The supported workaround is a
# stub outside the package; we generate one in the temp directory so the repo
# only needs the files listed in docs/00-interfaces.md section 1.
_ENTRY_SOURCE = '''\
"""Generated by build/lolping.spec -- frozen entry point for lolping."""

import sys

from lolping.__main__ import main

if __name__ == "__main__":
    sys.exit(main())
'''

_entry_dir = Path(tempfile.gettempdir()) / "lolping-build-entry"
_entry_dir.mkdir(parents=True, exist_ok=True)
_entry_script = _entry_dir / "lolping_entry.py"
_entry_script.write_text(_ENTRY_SOURCE, encoding="utf-8")

# --------------------------------------------------------------------------
# Modules PyInstaller cannot discover on its own
# --------------------------------------------------------------------------
hiddenimports = [
    # pynput imports its OS backend lazily inside a helper function, so the
    # static analyser only sees ``from pynput import keyboard, mouse``.
    # Without these the frozen exe cannot install the global hook at all.
    "pynput.keyboard._win32",
    "pynput.mouse._win32",
    "pynput._util.win32",
    "pynput._util.win32_vks",
    # The UI imports these directly; listing them explicitly is belt and
    # braces against a missing/partial PyQt5 hook.
    "PyQt5.QtCore",
    "PyQt5.QtGui",
    "PyQt5.QtWidgets",
    "PyQt5.sip",
]

excludes = [
    # CPython libraries lolping never uses (shaves ~3-5 MB).
    "tkinter",
    "unittest",
    "email",
    "http",
    "test",
    "xml",
    "pydoc_data",
    # Unused Qt subsystems.  The QtWebEngine* entries must be spelled out one
    # by one: PyInstaller's ``excludes`` does not accept wildcards.
    "PyQt5.QtWebEngine",
    "PyQt5.QtWebEngineCore",
    "PyQt5.QtWebEngineWidgets",
    "PyQt5.QtWebEngineQuick",
    "PyQt5.QtNetwork",
    "PyQt5.QtQml",
    "PyQt5.QtQmlModels",
    "PyQt5.QtQuick",
    "PyQt5.QtQuick3D",
]

# --------------------------------------------------------------------------
# Analysis / build
# --------------------------------------------------------------------------
a = Analysis(
    [str(_entry_script)],
    pathex=[str(SRC)],
    binaries=[],
    datas=[],
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name=APP_NAME,
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,
    # Keep the default behaviour of showing a traceback dialog for unhandled
    # exceptions; a silent crash is much harder for a student to diagnose.
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=str(ICON_PATH) if ICON_PATH.is_file() else None,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name=APP_NAME,
)
